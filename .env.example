DEBUG=False
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=zencraftsolution.com,www.zencraftsolution.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/zencraft_db
DASHBOARD_PATH=hq/
# Set to 1 when running behind exactly one reverse proxy (nginx) that appends X-Forwarded-For
TRUSTED_PROXY_COUNT=0
# Virus scanning (defaults to apps.core.uploads.clamav_scan when DEBUG=False)
UPLOAD_SCAN_HOOK=apps.core.uploads.clamav_scan
CLAMAV_UNIX_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_URL=smtp+tls://apikey:SENDGRID_API_KEY@smtp.sendgrid.net:587
DEFAULT_FROM_EMAIL=Zencraft Solution <hello@zencraftsolution.com>
INTERNAL_NOTIFY_EMAIL=team@zencraftsolution.com
SITE_URL=https://zencraftsolution.com
ADMIN_SEED_PASSWORD=
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
KHALTI_SECRET_KEY=
STRIPE_SECRET_KEY=

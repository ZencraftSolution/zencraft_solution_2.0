DEBUG=False
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=zencraftsolution.com,www.zencraftsolution.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/zencraft_db
DASHBOARD_PATH=hq/
# Public media storage. Required on Render (ephemeral disk); leave empty locally to use local files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used by `python manage.py ensure_superuser` in the Render build command
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# How many reverse proxies in front of Django append to X-Forwarded-For.
# 0 = ignore the header entirely (correct when Django is exposed directly).
# 1 = the right value on Render, and for a single nginx in front of gunicorn.
# Too low and every visitor shares the proxy's address, so one failed login locks out everyone;
# too high and the value is attacker-controlled. Verify it after deploying: see the README.
TRUSTED_PROXY_COUNT=0
# Shared cache for login lockouts, rate limits and site settings.
# Leave empty in production to use the database cache (run `manage.py createcachetable` in the build).
# Set to redis://... or rediss://... when you add a Redis instance. Never LocMem in production:
# it is per gunicorn worker and is wiped on restart, which resets lockout counters.
CACHE_URL=
# Staff sign-in. Sessions end this many hours after signing in, whatever the person is doing.
STAFF_SESSION_HOURS=8
# Two-factor authentication for staff. Enrol every staff account from HQ > Security FIRST,
# then set this to True; turning it on before that locks out anyone without an authenticator.
STAFF_2FA_REQUIRED=False
OTP_TOTP_ISSUER=Zencraft Solution
# Content-Security-Policy. Start with True after any front-end change: violations are reported
# but nothing is blocked. Switch back to False once the reports are clean.
CSP_REPORT_ONLY=False
# Optional endpoint that collects CSP violation reports (e.g. a report-uri.com URL).
CSP_REPORT_URI=
# How many days before the same email address may apply for the same role again.
CAREERS_REAPPLY_DAYS=30
# Private file storage for CVs and requirement documents.
# "local" keeps them in private_media/ (development, or a host with a real persistent disk).
# "s3" is any S3-compatible bucket: AWS, Cloudflare R2, Backblaze B2, DigitalOcean Spaces.
PRIVATE_STORAGE_BACKEND=local
PRIVATE_MEDIA_PERSISTENT=False
PRIVATE_S3_BUCKET=
PRIVATE_S3_REGION=
PRIVATE_S3_ENDPOINT_URL=
PRIVATE_S3_ACCESS_KEY=
PRIVATE_S3_SECRET_KEY=
PRIVATE_S3_PREFIX=private
# Seconds a signed URL for a private object stays valid. Nothing hands these to a browser.
PRIVATE_S3_URL_SECONDS=300
# Upload scanning: strict (scan during the upload), quarantine (hold until a scheduled job scans
# it, for hosts where the web process cannot reach ClamAV), or off (DEBUG only).
UPLOAD_SCAN_MODE=quarantine
# How long an inquiry that never became a project is kept. The privacy policy promises 24 months.
INQUIRY_RETENTION_DAYS=730
# Seconds before a slow mail server is given up on, so a web worker is not held open.
EMAIL_TIMEOUT=10
# Logging. "json" in production for a log search backend, "text" locally.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Optional error reporting. Reports are scrubbed of request bodies, cookies and personal fields.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Virus scanning (defaults to apps.core.uploads.clamav_scan when DEBUG=False)
UPLOAD_SCAN_HOOK=apps.core.uploads.clamav_scan
CLAMAV_UNIX_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_URL=smtp+tls://apikey:SENDGRID_API_KEY@smtp.sendgrid.net:587
DEFAULT_FROM_EMAIL=Zencraft Solution <hello@zencraftsolution.com>
INTERNAL_NOTIFY_EMAIL=team@zencraftsolution.com
SITE_URL=https://zencraftsolution.com
ADMIN_SEED_PASSWORD=
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
KHALTI_SECRET_KEY=
STRIPE_SECRET_KEY=

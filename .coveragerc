[run]
source = apps
# Branch coverage, not just line coverage: "if the signature is valid" counts as covered when
# only the valid path has ever run, which is exactly the half that does not matter.
branch = True
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */conftest.py
    apps/core/testing.py

[report]
show_missing = True
skip_empty = True
precision = 1
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
